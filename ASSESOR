    public function upload_expenses(Request $request)
    {
        // dd($request->all());
        try {
            DB::beginTransaction();

            //documents upload
            $folder = ('uploads/companyassessorexpenses/' . $request->company_project_id);
            ## CREATE FOLDER
            if (!File::exists($folder)) {
                mkdir($folder, 0777, true);
                chmod($folder, 0777);
            }
            $path = '';


            if ($file = $request->hasFile('regFeeInvoice')) {
                $file = $request->file('regFeeInvoice');
                $fileName = date('YmdHis') . "_" . $file->getClientOriginalName();
                $destinationPath = $folder;
                $file->move($destinationPath, $fileName);
                $path = $destinationPath . '/' . $fileName;
            }

            $amount = $request->invoiceamount;
            $cgst = ($amount * $request->cgst) / 100;
            $sgst = ($amount * $request->sgst) / 100;
            $igst = ($amount * $request->igst) / 100;
            $totalAmount = $amount +$cgst +$sgst +$igst;
            $company = Company::find($request->company_refid);
            $companyVal = new CompanyInvoice();
            $companyVal->company_id = $request->company_refid;
            $companyVal->company_reg_id = $company->reg_id;
            $companyVal->project_id = $request->company_project_id;
            $companyVal->payment_for = 'exp';
            $companyVal->invoice_title = $request->invoicetitle;
            $companyVal->amount = $amount;
            $companyVal->cgst = $cgst;
            $companyVal->sgst = $sgst;
            $companyVal->igst = $igst;
            $companyVal->total_amount = $totalAmount;
            $companyVal->assessor_id = $this->loggedInUser->id;
            $companyVal->invoice = $path;

            if ($companyVal->save()) {
                DB::commit();

                __activity_log($request->company_refid, $request->company_project_id, 'Assessor ' . $this->loggedInUser->name . ' has uploaded the Expense Document', 'assessor', $this->loggedInUser->name, 2, false);
                __notification_log('Assessor has uploaded the Expense document', 'Assessor ' . $this->loggedInUser->name . ' has been uploaded the Expense Document for project ' . $company->project_id, 'A', null);
                $coordinatordetails  = CompanyCoordinator::with('Company_Assign_Coordinator')->where('project_id', $request->company_project_id)->orderby('created_at', 'desc')->first();
                if (isset($coordinatordetails)) {
                    __notification_log('Assessor has uploaded the Expense document', 'Assessor ' . $this->loggedInUser->name . ' has been uploaded the Expense Document for project ' . $company->project_id, 'CO', $coordinatordetails->coordinator_id);
                }
                $data = ['companyname' => $company->name, 'path' => url($path), 'project_id' => $company->project_id, 'assessorname' => $this->loggedInUser->name];
                Mail::to(ADMIN_EMAILID)->send(new assessor_expenses_upload($data));
            }

            return response()->json(['status' => 'success', 'message' => 'Expense Uploaded Successfully!']);
        } catch (\Throwable $th) {
            DB::rollBack();
            return $th;
            return response()->json(['status' => 'error', 'message' => 'Some Error Occurred. Please try again after sometime!']);
        }
    }

