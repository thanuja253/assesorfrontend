<script type="text/javascript">
    var Registration = function () {
        return { //main function to initiate the module
            init: function () {

                jQuery.validator.addMethod("decimalTwo", function(value, element) {
                    return this.optional(element) || /^\d+(?:\.\d{1,2})?$/.test(value);
                }, "The format must be in two decimal");

                jQuery.validator.addMethod("noSpace", function(value, element) {
                    return value == '' || value.trim().length != 0;
                }, "This field is required");

                jQuery.validator.addMethod("doubleSpace", function(value, element) {
                    return this.optional(element) || /^\S((?!.*  ).*\S)?$/.test(value);
                }, "This field is required");

                //Add Expense Form validations
                $('#add-expense-form').validate({
                    rules: {
                        'invoicetitle': {
                            required: true,
                            noSpace: true,
                            doubleSpace:true,
                            maxlength: 50,
                            minlength:3
                        },
                        'invoiceamount': {
                            required: true,
                            decimalTwo: true,
                            min:1
                        },
                        'regFeeInvoice': {
                            required: true,
                        },
                            'sgst': {
                            required: true,
                            decimalTwo: true,
                        },
                        'cgst': {
                            required: true,
                            decimalTwo: true,
                        },
                        'igst': {
                            required: true,
                            decimalTwo: true,
                        }
                    },
                    messages:{
                        invoicetitle: {
                            required: "The Title field is Required.",
                            noSpace : "Please enter a valid title",
                            doubleSpace : "Please enter a valid title"
                        },
                        invoiceamount: {
                            required: "The Amount field is Required.",
                        },
                        regFeeInvoice : {
                            required : "The Document field is Required."
                        },
                        sgst: {
                            required: "SGST Field is Required"
                        },
                        cgst: {
                            required: "CGST Field is Required"
                        },
                        igst: {
                            required: "IGST Field is Required"
                        }

                    },
                    submitHandler : function(form){
                        $("#inv_upload").html("Loading....");
                        $("#inv_upload").attr('disabled',true);
                        let formdata = new FormData(document.getElementById("add-expense-form"));
                        $.ajax({
                            type: "POST",
                            url: $('form#add-expense-form').attr('action'),
                            data: formdata,
                            contentType: false,
                            processData: false,
                            success: function(response) {
                                if(response.status == 'validations') {
                                    $.each(response.errors, function (key, error) {
                                        $("#inv_upload").html("Submit");
                                        $("#inv_upload").attr('disabled',false);
                                        $('form#add-expense-form').find("#" + key).removeClass('error').addClass('error');
                                        $('form#add-expense-form').find("#" + key + "-error").text(error[0]);
                                    });
                                }
                                if(response.status == 'success') {
                                    $('.error').css('display','none');
                                    JsUtility.showToastr('success', 'Assessor', response.message);
                                    setTimeout(function(){
                                    location.reload();
                                    }, 3000);

                                }

                                if(response.status == 'error') {
                                    $('#inv_upload').html('Save');
                                    $('#inv_upload').attr('disabled',false);
                                    JsUtility.showToastr('error', 'Assessor', response.message);
                                }
                            },
                            error: function() {
                                $('#inv_upload').html('Save');
                                $('#inv_upload').attr('disabled',false);
                                JsUtility.showToastr('error', 'Assessor', response.message);
                            }
                        });

                    }

                });

             
            }
        }
    }();
    jQuery(document).ready(function() {
        Registration.init();

        $('.txtQty').on('blur',function(event) {
            var amt = parseFloat(this.value);
            $(this).val(amt.toFixed(2));
        });

        $('input[type=text]').on('keyup',function(event){
            event.currentTarget.value = this.value.toUpperCase();
        });
    });
</script>
<script>

    //display expense tab 
    $("#addexpensebutton").click(function(){
        $("#addexpenstab").css('display','block');
    });

    // display remarks when selects payment approval status is disapproved
    $("#status").change(function (e) {
        e.preventDefault();
        let approveStatus = $(this).val();
        if (approveStatus=="2"){
            $("#disApproved").removeClass('d-none');
            $("#remove").addClass('d-none');
            $("#approved").addClass('d-none');
        }else{
            $("#disApproved").addClass('d-none');
            $("#remove").addClass('d-none');
            $("#approved").addClass('d-none');
        }
    });

    $('#regFeeInvoice').on('change', function(e) {
        e.preventDefault();
        $('#regFeeInvoice-error').css("display", "none");
        var extension = e.target.files[0].name.split('.').pop().toLowerCase()
        var reader = new FileReader();
        reader.onload = function(e) {
            if (extension == 'pdf') {
                $('#regFeeInvoice-error').css("display", "none");
                $('#regFeeInvoice-error').html('');
                $("#regFeeInvoice_error").css("display", "none");
                $('#inv_upload').attr('disabled',false);
                return true;
            }
            else{
                $('#regFeeInvoice-error').css("display", "none");
                $('#regFeeInvoice-error').html('');
                $("#regFeeInvoice_error").css("display", "block");
                document.getElementById('regFeeInvoice').value= null;
                $('#inv_upload').attr('disabled',true);
                return false;
            }
        }
        reader.readAsDataURL(e.target.files[0]);
    });
    
</script>

