    public function update_assessor_score(Request $request)
    {
        try {
            $checklist_criteria_docs =  MasterChecklistDocs::join('master_document_sectors', 'master_documents.id', '=', 'master_document_sectors.mst_document_id')
                ->where('master_document_sectors.group_id', $request->group_id)->select('master_documents.*')
                ->where('criteria_id', $request->criteria_id)->where('required_type', '1')->orderBy('id', 'asc')->get();
            $i = 1;
            $j = 0;
            foreach ($checklist_criteria_docs as $doc) {
                DB::beginTransaction();
                $score = 'assesmentscore' . $i;
                $remark = 'remarks' . $i;
                $id = 'score_id' . $i;
                if (isset($request->$score)) {
                    $updatescore = CompanyAssessmentScoring::where('id', $request->$id)
                        ->update(['assesment_score' => $request->$score, 'assessor_remarks' => $request->$remark, 'assessor_id' => Auth::user()->id, 'assessor_updated_at' => Carbon::now()]);
                    $j++;
                }
                $i++;
                DB::commit();
            }

            return response()->json(['status' => 'success', 'message' => $j . ' Parameters Scoring Data Saved Successfully.']);
        } catch (\Exception $e) {
            DB::rollback();
            return $e;
            return response()->json(['status' => 'error', 'message' => 'Something went wrong. Please try again.']);
        }
    }

