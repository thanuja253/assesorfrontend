namespace App\Exports;

use Facades\App\Repository\SectorRepo;
use App\Models\CompanyProject;
use App\Models\MasterSector;
use DB;

use Maatwebsite\Excel\Concerns\Exportable;
use Maatwebsite\Excel\Concerns\WithMultipleSheets;

class AssessmentScoringExport implements WithMultipleSheets
{
    use Exportable;

    protected $project_id;
    
    public function __construct(int $project_id)
    {
        $this->project_id = $project_id;
    }

    /**
     * @return array
     */
    public function sheets(): array
    {
        $sheets = [];
        $sector_id = CompanyProject::where('id',$this->project_id)->select('mst_sector_id')->first();
        $this->data['sector'] =MasterSector::where('id',$sector_id->mst_sector_id)->orderby('created_at','desc')->first();
        // $this->data['sector'] = SectorRepo::allActive($orderColumn="created_at", $orderDir='desc')->where('id',$sector_id->mst_sector_id)->first();
        $this->data['checklist_criteria'] =  DB::table('checklist_criterions')
                                            ->select('checklist_criterions.id')
                                            ->join('master_checklist_sectors', 'checklist_criterions.id', '=', 'master_checklist_sectors.criterian_id')
                                            ->where('master_checklist_sectors.group_id',$this->data['sector']->group_id)->get();
        $sheets[] = new SummarySheet($this->project_id,$this->data['sector']->group_id);
        for ($i = 0; $i < count($this->data['checklist_criteria']); $i++) {
            $sheets[] = new ScoringPerCriteriaSheet($this->project_id, $this->data['checklist_criteria'][$i]->id,$this->data['sector']->group_id);
        }

        return $sheets;
    }
}
