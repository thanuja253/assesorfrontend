     */
    public function __construct()
    {
        $this->data['activeMenu'] = 'Company Portal';
        parent::__construct();

        $this->middleware(function ($request, $next) {
            $this->loggedInUser = auth('assessor')->user();
            $this->data['authdata'] = auth('assessor')->user();
            $notify =  __get_notifications('assessor', auth('assessor')->user()->id);
            $this->data['notifications'] =  $notify['notifications'];
            $this->data['notificationsCount'] =  $notify['notificationsCount'];

            //coordinators data
            $this->data['coordinators'] = CompanyCoordinator::with('Company_Assign_Coordinator', 'Coordinator_Detail')->where(['project_id' => $request->projectid])->get();
            //for company work order logs data
            $this->data['company_wo'] =  CompanyWoLog::with('Company_Detail')->where('project_id', $request->projectid)->orderby('created_at', 'desc')->first();
            // ->wherein('wo_status',['0','2'])
            // for company invoice table data
            $this->data['company_invoice'] =  CompanyInvoice::with('Company_Payment')->where('project_id', $request->projectid)->orderby('created_at', 'desc')->first();
            // for company and facilitator assigned data
            $this->data['companies_facilitator'] =  CompanyFacilitator::with('Company_Assign_Facilitator', 'Facilitator_Detail')->where('project_id', $request->projectid)->orderby('created_at', 'desc')->first();
            // for company and coordinator assigned data
            $this->data['companies_coordinator'] = CompanyCoordinator::with('Company_Assign_Coordinator')->where('project_id', $request->projectid)->orderby('created_at', 'desc')->first();
            // for displaying company activty log
            $this->data['companies_activty'] = CompanyActivtyLog::with('Company_Link')->where('project_id', $request->projectid)->orderby('created_at', 'desc')->get();
            // for display visit details
            $this->data['companies_assessor'] = CompanyAssessor::with('Assessor_Detail')->where('project_id', $request->projectid)->groupby('assessor_id')->orderby('created_at', 'desc')->get();
            return $next($request);
        });
    }

