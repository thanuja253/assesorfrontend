    public function data(Request $request)
    {
        $company = DB::table('companies')
            ->select('companies_projects.*', 'companies.reg_id', 'companies.name', 'companies.mobile', 'companies.email', 'companies.account_status', 'companies.verified_status', 'companies.status_updated_at', 'companies.verified_at')
            ->join('companies_projects', 'companies.id', '=', 'companies_projects.company_id')
            ->join('companies_assessor', 'companies_projects.id', '=', 'companies_assessor.project_id')
            ->where('companies_assessor.assessor_id', $this->loggedInUser->id)
            ->where('companies_projects.project_status', '!=', 4)
            ->groupby('companies_projects.id')->orderBy('companies_projects.id', 'DESC');
        // dd($company->get());
        return  Datatables::of($company)
            ->addIndexColumn()
            ->addColumn('reg_id', function ($company) {
                if ($company->reg_id == null) {
                    return 'N/A';
                } else {
                    // return '<a href="' . route('admin.company.view', $company) . '" >' . $company->reg_id . ' </a>';
                    return $company->reg_id;
                }
            })
            ->addColumn('project_id', function ($company) {
                if ($company->project_id == null) {
                    return 'N/A';
                } else {
                    // return '<a href="' . route('admin.company.view', $company) . '" >' . $company->reg_id . ' </a>';
                    return $company->project_id;
                }
            })
            ->filter(function ($query) use ($request) {
                if ($request->has('reg_id') && $request->reg_id != "") {
                    $query->where('reg_id', 'like', "%{$request->get('reg_id')}%");
                }
                if ($request->has('name') && $request->name != "") {
                    $query->where('name', 'like', "%{$request->get('name')}%");
                }
                if ($request->has('mobile') && $request->mobile != "") {
                    $query->where('mobile', 'like', "%{$request->get('mobile')}%");
                }
                if ($request->has('email') && $request->email != "") {
                    $query->where('email', 'like', "%{$request->get('email')}%");
                }

                if ($request->has('status') && $request->status != "") {
                    $query->where('account_status', $request->status);
                }

                if ($request->has('state') && $request->state != "") {
                    $query->where('state', $request->state);
                }

                if ($request->has('industry') && $request->industry != "") {
                    $query->where('mst_industry_id', $request->industry);
                }

                if ($request->has('sector') && $request->sector != "") {
                    $query->where('mst_sector_id', $request->sector);
                }

                if ($request->has('entity') && $request->entity != "") {
                    $query->where('mst_entity_id', $request->entity);
                }

                if ($request->has('verification_status') && $request->verification_status != "") {
                    $query->where('verified_status', $request->verification_status);
                }

                if ($request->has('fromturnover') && $request->fromturnover != "" && $request->has('toturnover') && $request->toturnover != "") {
                    $query->whereBetween('turnover', [$request->fromturnover, $request->toturnover]);
                }

                if ($request->has('search') && @$request->search['value'] != "") {
                    $query->where('mobile', 'like', "%{$request->search['value']}%");
                    $query->orWhere('email', 'like', "%{$request->search['value']}%");
                    $query->orWhere('name', 'like', "%{$request->search['value']}%");
                }
            })
            ->make(true);
    }

