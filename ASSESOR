    public function exportBlock(Request $request)
    {
        $assessor =  DB::table('companies')
            ->select('companies_projects.*', 'companies.reg_id', 'companies.name', 'companies.mobile', 'companies.email', 'companies.account_status', 'companies.verified_status', 'companies.status_updated_at', 'companies.verified_at')
            ->join('companies_projects', 'companies.id', '=', 'companies_projects.company_id')
            ->join('companies_assessor', 'companies_projects.id', '=', 'companies_assessor.project_id')
            ->where('companies_assessor.assessor_id', $this->loggedInUser->id)
            ->groupby('companies_projects.id')->orderBy('companies_projects.id', 'DESC');

        if (!is_null($request->name)) $assessor = $assessor->where('name', 'LIKE', "%{$request->name}%");
        if (!is_null($request->email)) $assessor = $assessor->where('email', 'LIKE', "%{$request->email}%");
        if (!is_null($request->mobile)) $assessor = $assessor->where('mobile', $request->mobile);
        if (!is_null($request->status)) $assessor = $assessor->where('status', $request->status);
        if (!is_null($request->verificationStatus)) $assessor = $assessor->where('verification_status', $request->verificationStatus);

        $assessor = $assessor->get();
        // dd($assessor);
        return Excel::download(new AccessorCompanyExport($assessor), 'assessors.xlsx');
    }

